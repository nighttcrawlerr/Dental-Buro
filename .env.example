# Скопировать в .env.local и заполнить. .env.local в репозиторий не попадает.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# id группы, куда приходят заявки (отрицательное число)
TELEGRAM_CHAT_ID=

# Адрес сайта без слеша на конце, например https://dentalburo.ru
SITE_URL=

# Номер счётчика Яндекс Метрики. Пусто — Метрика и плашка cookie отключены.
NEXT_PUBLIC_YM_ID=

# База заявок (PostgreSQL на российском хостинге). Локально:
# postgres://localhost:5432/dental_buro, схема — npm run db:migrate
DATABASE_URL=

# Вход в раздел заявок /admin. Пароль — один на администраторов.
ADMIN_PASSWORD=
# Секрет подписи сессии, не короче 32 символов: openssl rand -base64 48
# Смена секрета разлогинивает всех.
ADMIN_SESSION_SECRET=
